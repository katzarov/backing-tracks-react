{
  "name": "backing-tracks-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tsc": "tsc --noEmit --watch",
    "build": "tsc && vite build",
    "test": "vitest run --config=vitest.config.ts --browser.headless",
    "test:coverage": "vitest run --config=vitest.config.ts --browser.headless --coverage",
    "test:ui": "vitest --config=vitest.config.ts --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "pnpm": ">=10.24.0 <11.0.0",
    "node": ">=22.21.0 <23.0.0"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.1.3",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@reduxjs/toolkit": "^2.2.1",
    "backing-tracks-isomorphic": "^1.0.5",
    "formik": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.0.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.1",
    "redux-remember": "^5.1.0",
    "wavesurfer.js": "^7.7.3",
    "yup": "^1.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "msw": "^2.12.7",
    "playwright": "^1.54.1",
    "typescript": "^5.2.2",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.16",
    "vitest-browser-react": "^2.0.2"
  }
}
